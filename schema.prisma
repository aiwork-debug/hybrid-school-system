generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Subject {
  MATH
  SCIENCE
  ENGLISH
  URDU
  COMPUTER_SCIENCE
  SOCIAL_STUDIES
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  roleSelected  Boolean   @default(false) // false until the user (or Google signup) confirms their role
  subject       Subject? // only set for teachers, via subject-selection step
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  coursesTaught    Course[]          @relation("TeacherCourses")
  enrollments      Enrollment[]
  attendanceLogs   AttendanceLog[]
  recordedLectures RecordedLecture[]
  liveClasses      LiveClass[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  subject     Subject // used by students to filter/browse courses
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacherId String
  teacher   User   @relation("TeacherCourses", fields: [teacherId], references: [id])

  enrollments Enrollment[]
  liveClasses LiveClass[]
  assignments Assignment[]
  chapters    Chapter[]
}

model Chapter {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  recordedLectures RecordedLecture[]
}

model Enrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model LiveClass {
  id          String   @id @default(cuid())
  title       String
  meetingUrl  String
  scheduledAt DateTime
  courseId    String
  course      Course   @relation(fields: [courseId], references: [references], onDelete: Cascade) // ya id
  createdAt   DateTime @default(now())
}

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id])

  attendanceLogs AttendanceLog[]
}
model RecordedLecture {
  id           String   @id @default(cuid())
  title        String
  description  String?
  videoUrl     String
  slidesUrl    String?   // Slides URL file upload ke liye
  durationMins Int?
  createdAt    DateTime @default(now())

  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])

  attendanceLogs AttendanceLog[]
}
model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])
}

model AttendanceLog {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id])

  liveClassId String?
  liveClass   LiveClass? @relation(fields: [liveClassId], references: [id])

  recordedLectureId String?
  recordedLecture   RecordedLecture? @relation(fields: [recordedLectureId], references: [id])
}
